{
  "name": "diffnote",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/code-editor.js --bundle --minify --format=iife --global-name=DiffEditor --outfile=dist/vendor/code-editor.js --legal-comments=eof",
    "build:extension": "npm run build && python3 scripts/build-extension.py",
    "test:folding": "node tests/folding.cjs",
    "test:layout": "node tests/layout.cjs",
    "test:lines": "node tests/line-highlights.cjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-cpp": "^6.0.0",
    "@codemirror/lang-css": "^6.3.0",
    "@codemirror/lang-go": "^6.0.0",
    "@codemirror/lang-html": "^6.4.0",
    "@codemirror/lang-java": "^6.0.0",
    "@codemirror/lang-javascript": "^6.2.0",
    "@codemirror/lang-json": "^6.0.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/lang-python": "^6.2.0",
    "@codemirror/lang-sql": "^6.9.0",
    "@codemirror/lang-xml": "^6.0.0",
    "@codemirror/lang-yaml": "^6.1.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/legacy-modes": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "playwright-core": "^1.65.0"
  }
}
