{
  "name": "shixu-workspace",
  "private": true,
  "version": "2.0.0",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "format": "prettier --write dist/app.js dist/storage.js dist/workspace.js dist/style.css dist/index.html tests/*.test.cjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --target aarch64-apple-darwin",
    "desktop:test": "cargo test --manifest-path src-tauri/Cargo.toml -p shixu-storage"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10"
  }
}
