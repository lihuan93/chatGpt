{
  "manifest_version": 3,
  "name": "本地账号簿",
  "description": "本地管理账号密码，按当前域名选择填充，支持 JSON 导入、导出。",
  "version": "1.3.0",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "选择账号并填充",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icons/icon.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
